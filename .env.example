# Keep existing DATABASE_URL and GOOGLE_GENERATIVE_AI_API_KEY in your private .env.
DATABASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_SITE_URL=https://www.syadiloh.co.uk
# database is selected automatically when DATABASE_URL exists.
# snapshot provides an offline preview of the committed publication.
TRAVEL_DATA_MODE=database
# Required for cron and cache invalidation endpoints. Never expose publicly.
CRON_SECRET=
